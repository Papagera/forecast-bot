<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- forecast-bot: прогон раз в 2,5 ч. Ставится ТОЛЬКО по слову income: bash deploy/install_launchagent.sh
     Отправка всё равно не пойдёт без FORECAST_SUBMIT=1 в .env (раннер выйдет с кодом 3). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nikita.forecast-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nikitanikita/Desktop/КЛОД/forecast-bot/deploy/run_scheduled.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/nikitanikita/Desktop/КЛОД/forecast-bot</string>
  <key>StartInterval</key><integer>9000</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/nikitanikita/.forecast-bot/run.log</string>
  <key>StandardErrorPath</key><string>/Users/nikitanikita/.forecast-bot/run.log</string>
</dict>
</plist>
