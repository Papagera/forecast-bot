# forecast-bot — образец .env (сам .env в .gitignore). Ключи кладутся БЕЗ чата:
#   printf 'ИМЯ: '; read -rs V; echo; printf 'ИМЯ=%s\n' "$V" >> .env; unset V; chmod 600 .env

# Токен БОТ-аккаунта Metaculus (metaculus.com/accounts/settings/ → My Forecasting Bots → Create a Bot).
METACULUS_TOKEN=
# OpenRouter: свой ключ с лимитом, затем ключ кредитов Metaculus (forms.gle/aQdYMq9Pisrf1v7d8).
OPENROUTER_API_KEY=
# AskNews (my.asknews.app/en/settings/api-credentials, после активации через contact@asknews.app).
ASKNEWS_API_KEY=

# Отправка в Metaculus. Ставить 1 ТОЛЬКО после «да» income; без неё --mode submit откажется.
# FORECAST_SUBMIT=1

# Необязательно (дефолты — в forecast_bot/bot.py):
# FORECAST_MODEL=openrouter/anthropic/claude-opus-5.5
# FORECAST_PARSER_MODEL=openrouter/openai/gpt-4o-mini
# FORECAST_PREDICTIONS=5
